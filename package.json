{
  "name": "priyanshu-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "start": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.vite.json --noEmit",
    "test:terminal": "node --test tests/terminal.test.mjs",
    "test:content": "node --test tests/personal-records.test.mjs",
    "check:content": "node scripts/check-personal-content.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "preview": "vite preview",
    "dev:legacy": "next dev",
    "build:legacy": "next build --webpack",
    "typecheck:legacy": "next typegen && tsc --noEmit",
    "test:certificates": "node --test tests/certificate-search.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
